    @template local_beacon/studio

    The Report Studio page.

    Example context (json):
    {
        "heading": "Report Studio", "tagline": "Describe the report you need.",
        "intro": "Type what you want.", "ask": "What report do you need?",
        "placeholder": "e.g. completion by course", "buildlabel": "Build my report",
        "exampleslabel": "Try one of these", "noai": "No AI", "formaction": "#",
        "contextid": 1, "query": "", "examples": [{"label": "Enrolments per month", "url": "#"}],
        "hasresult": false
    }
}}
<div class="bc-root" data-region="beacon-studio">
  <div class="bc-wrap">

    <div class="bc-page-head">
      <div>
        <h1 class="bc-h1">{{heading}}</h1>
        <p class="bc-sub">{{tagline}}</p>
      </div>
      <div class="bc-head-actions">
        <span class="bc-studio-badge">{{noai}}</span>
        <button type="button" class="bc-btn bc-btn-ghost bc-theme-toggle" data-role="theme-toggle" aria-label="{{#str}}toggletheme, local_beacon{{/str}}" title="{{#str}}toggletheme, local_beacon{{/str}}">
          <svg class="bc-ico-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="bc-ico-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <p class="bc-studio-intro">{{intro}}</p>

    <form class="bc-studio-form" method="get" action="{{formaction}}" role="search">
      <input type="hidden" name="contextid" value="{{contextid}}">
      <label class="bc-studio-ask" for="bc-studio-q">{{ask}}</label>
      <div class="bc-studio-inputrow">
        <svg class="bc-studio-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="bc-studio-q" class="bc-studio-input" type="text" name="q" value="{{query}}" placeholder="{{placeholder}}" autocomplete="off" autofocus>
        <button type="submit" class="bc-btn bc-btn-primary bc-studio-go">{{buildlabel}}</button>
      </div>
    </form>

    <div class="bc-studio-examples">
      <span class="bc-studio-examples-label">{{exampleslabel}}</span>
      {{#examples}}<a class="bc-chip" href="{{url}}">{{label}}</a>{{/examples}}
    </div>

    {{#hasresult}}
    <div class="bc-studio-panel">
      <div class="bc-studio-readas">
        <div class="bc-studio-readas-head">{{readaslabel}}</div>
        <div class="bc-studio-explain">{{explanation}}</div>
        <div class="bc-studio-meta">{{grain}}</div>
        {{#notes}}<div class="bc-studio-note">{{text}}</div>{{/notes}}
      </div>

      {{#error}}<div class="bc-studio-error">{{error}}</div>{{/error}}

      {{#hasheadline}}
      <div class="bc-studio-headline">
        <div class="bc-studio-headline-value">{{headline}}</div>
        <div class="bc-studio-headline-label">{{headlinelabel}}</div>
      </div>
      {{/hasheadline}}

      {{#haschart}}
      <div class="bc-studio-chart">
        <div class="bc-studio-charttype"><span class="bc-studio-dot"></span>{{charttype}}</div>
        <div class="bc-studio-canvas">{{{charthtml}}}</div>
      </div>
      {{/haschart}}

      {{#table}}
      <div class="bc-studio-results">
        <div class="bc-studio-results-head">{{resultslabel}}</div>
        <table class="bc-studio-table">
          <thead><tr>{{#columns}}<th>{{label}}</th>{{/columns}}</tr></thead>
          <tbody>
            {{#rows}}<tr>{{#cells}}<td class="{{#first}}bc-studio-c0{{/first}}{{^first}}bc-studio-cn{{/first}}">{{v}}</td>{{/cells}}</tr>{{/rows}}
          </tbody>
        </table>
      </div>
      {{/table}}

      {{#sqlpreview}}
      <details class="bc-studio-sql">
        <summary>{{showsql}} <span class="bc-studio-sqlnote">· {{sqllabel}}</span></summary>
        <pre class="bc-studio-sqlpre">{{sqlpreview}}</pre>
      </details>
      {{/sqlpreview}}
    </div>
    {{/hasresult}}

  </div>
</div>
