<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/beacon/db" VERSION="20260730" COMMENT="Beacon reporting for Moodle."
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_beacon_request" COMMENT="A request from an admin to have a new stat card, KPI gauge or report built.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="stat, kpi or report"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Requested name."/>
        <FIELD NAME="detail" TYPE="text" NOTNULL="true" COMMENT="What it should show."/>
        <FIELD NAME="requestername" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="Name of the requester."/>
        <FIELD NAME="requesteremail" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="Reply-to email."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Moodle user who submitted it."/>
        <FIELD NAME="siteurl" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="Site the request came from."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="sent" COMMENT="sent or failed"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_beacon_snapshot" COMMENT="Daily value of each metric, so cards can show a real trend line over time.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="metric" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Metric id."/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="value" TYPE="number" LENGTH="20" DECIMALS="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="daykey" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="YYYYMMDD, so one row per metric per day."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="metric_ctx_day" UNIQUE="true" FIELDS="metric, contextid, daykey"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_beacon_metric_cache" COMMENT="Precomputed current value of each metric, so the library never computes on page load.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="metric" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Metric id."/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="value" TYPE="number" LENGTH="20" DECIMALS="4" NOTNULL="false" COMMENT="Current value; NULL means no data to measure."/>
        <FIELD NAME="denominator" TYPE="number" LENGTH="20" DECIMALS="4" NOTNULL="false" COMMENT="Rate denominator, for KPI no-data detection."/>
        <FIELD NAME="hasvalue" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="1 when value is a real figure, 0 when there was no data."/>
        <FIELD NAME="timecomputed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="metric_ctx" UNIQUE="true" FIELDS="metric, contextid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_beacon_savedview" COMMENT="A named, saved filter set for a report, private to the user who saved it.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Owner."/>
        <FIELD NAME="reportid" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Report the view belongs to."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="View name."/>
        <FIELD NAME="params" TYPE="text" NOTNULL="true" COMMENT="URL-encoded filter parameters."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="user_report" UNIQUE="false" FIELDS="userid, reportid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_beacon_delivery" COMMENT="A scheduled email delivery of a report (with saved filters) to recipients.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Owner who set it up."/>
        <FIELD NAME="reportid" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Report to send."/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" COMMENT="Delivery name."/>
        <FIELD NAME="params" TYPE="text" NOTNULL="true" COMMENT="URL-encoded filter parameters."/>
        <FIELD NAME="format" TYPE="char" LENGTH="8" NOTNULL="true" DEFAULT="pdf" COMMENT="pdf or csv."/>
        <FIELD NAME="frequency" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="weekly" COMMENT="daily, weekly or monthly."/>
        <FIELD NAME="recipients" TYPE="text" NOTNULL="true" COMMENT="Newline/comma-separated email addresses."/>
        <FIELD NAME="nextrun" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="When it next fires."/>
        <FIELD NAME="lastrun" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="nextrun" UNIQUE="false" FIELDS="nextrun"/>
        <INDEX NAME="downer" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
